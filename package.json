{
  "name": "blog-remix",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-content.js && remix vite:build",
    "dev": "node scripts/build-content.js && remix vite:dev",
    "deploy": "npm run build && wrangler pages deploy ./build/client",
    "dev:wrangler": "wrangler pages dev ./build/client --compatibility-date=2024-01-01",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "npm run build && wrangler pages dev ./build/client --compatibility-date=2024-01-01",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@remix-run/cloudflare": "^2.17.5",
    "@remix-run/cloudflare-pages": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@vercel/speed-insights": "^1.3.1",
    "date-fns": "^4.4.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "isbot": "^4",
    "marked": "^15.0.12",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@remix-run/dev": "^2.17.5",
    "@remix-run/node": "^2.17.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/caniuse-lite": "^1.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.5",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.28",
    "sass": "^1.104.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^3.114.17"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
